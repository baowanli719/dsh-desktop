{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "emitDeclarationOnly": false,
    // The vendored 0.1.2-rc.1 runtime ships mutually inconsistent type
    // declarations (dsh-session still augments Context.sessions as
    // SessionStore while dsh-api-session-controller declares ISessions);
    // tests type-import upstream client surfaces, which pulls both stale and
    // current d.ts into one program. Their conflicts are not our code.
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts", "src/*.ts", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": [
    "tests/client-boot-health.spec.ts",
    "tests/client-commands-submenu.spec.ts",
    "tests/client-desktop-settings.spec.ts",
    "tests/client-environment.spec.ts",
    "tests/client-layout-service.spec.ts",
    "tests/client-session-log-button.spec.ts",
    "tests/theme-presenter.spec.ts"
  ]
}
