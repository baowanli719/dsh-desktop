+const INLINE_IMAGE_DATA_URI = /^data:([^;,]+);base64,(.+)$/
+
+/**
+ * gs-worker desktop: both LLM proxy hops cap request bodies at 4 MiB, and
+ * the pixel-budget downscale never fires for small-but-dense PNGs whose raw
+ * bytes already exceed the cap. Bound the TOTAL raw inline-image bytes of one
+ * request instead: re-encode oversized images as JPEG with a descending
+ * quality ladder, then halve dimensions as a last resort; fail closed with
+ * VISION_IMAGE_PREPROCESS_FAILED when the budget cannot be met.
+ */
+async function boundInlineImageBytes(messages, totalBudget) {
+  const parts = []
+  for (const message of messages ?? []) {
+    const content = message ? message.content : undefined
+    if (!Array.isArray(content)) continue
+    for (const part of content) {
+      if (!part || part.type !== 'image_url') continue
+      const url = part.image_url && part.image_url.url
+      const match = typeof url === 'string' ? INLINE_IMAGE_DATA_URI.exec(url) : null
+      if (match) parts.push({ part, bytes: Buffer.from(match[2], 'base64') })
+    }
+  }
+  if (parts.length === 0) return
+  const total = parts.reduce((sum, entry) => sum + entry.bytes.length, 0)
+  if (total <= totalBudget) return
+  const fail = (cause) => {
+    const error = new Error('VISION_IMAGE_PREPROCESS_FAILED: inline images exceed the request byte budget')
+    error.code = 'VISION_IMAGE_PREPROCESS_FAILED'
+    if (cause !== undefined) error.cause = cause
+    throw error
+  }
+  const sharp = await loadSharp().catch(() => undefined)
+  if (sharp === undefined) fail()
+  const perImage = Math.max(262144, Math.floor(totalBudget / parts.length))
+  for (const entry of parts) {
+    if (entry.bytes.length <= perImage) continue
+    let output
+    for (const quality of [80, 65, 50, 35]) {
+      output = await sharp(entry.bytes, { failOn: 'none' }).jpeg({ quality }).toBuffer().catch(() => undefined)
+      if (output && output.length <= perImage) break
+      output = undefined
+    }
+    let width
+    const meta = await sharp(entry.bytes, { failOn: 'none' }).metadata().catch(() => undefined)
+    width = meta && typeof meta.width === 'number' ? meta.width : undefined
+    while (output === undefined && width !== undefined && width > 640) {
+      width = Math.floor(width / 2)
+      output = await sharp(entry.bytes, { failOn: 'none' })
+        .resize({ width, withoutEnlargement: true })
+        .jpeg({ quality: 60 })
+        .toBuffer()
+        .catch(() => undefined)
+      if (output && output.length > perImage) output = undefined
+    }
+    if (output === undefined || output.length > perImage) fail()
+    entry.part.image_url.url = `data:image/jpeg;base64,${output.toString('base64')}`
+  }
+}
