+// Desktop-managed vision: select the owned image-capable twin automatically.
+// The directory remains the authority; failed selections never fake success
+// or retry indefinitely, and a later ordinary model choice gets its own twin.
+export function requestManagedVision(state, config, attempt, select) {
+  if (!state || state.status === 'idle' || state.status === 'loading' || state.status === 'selecting') return
+  const pair = resolveVisionModePair(state.groups, state.current, config)
+  if (pair.mode !== 'off') {
+    attempt.key = undefined
+    return
+  }
+  const key = JSON.stringify(pair.target)
+  if (attempt.key === key) return
+  attempt.key = key
+  try {
+    return Promise.resolve(select(pair.target)).then(value => value !== false, () => false)
+  } catch {
+    return Promise.resolve(false)
+  }
+}
